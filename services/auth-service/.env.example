# StreamForge Auth Service — copy to .env and fill in values
# cp .env.example .env

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=auth-service

# Database (match docker-compose postgres)
DATABASE_URL=postgresql://streamforge:password@localhost:5432/streamforge_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use the same secrets across services in dev (min 32 chars)
JWT_ACCESS_SECRET=streamforge-dev-shared-jwt-secret-32charsminimum
JWT_REFRESH_SECRET=streamforge-dev-refresh-secret-32charsmin
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_SECRET=streamforge-dev-cookie-secret-32charsmin
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_CREATOR_PRICE_ID=price_replace_me
STRIPE_ENTERPRISE_PRICE_ID=price_replace_me

# Email (dev: use Mailtrap or similar)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
EMAIL_FROM=noreply@streamforge.local

# OAuth
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Internal service-to-service calls
INTERNAL_SERVICE_SECRET=streamforge-dev-internal-secret-32chars
